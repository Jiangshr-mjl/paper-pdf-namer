{
  "manifest_version": 3,
  "name": "Name-paper-cloud",
  "version": "0.1.4",
  "description": "下载文献时，按期刊缩写、年份、第一作者姓氏及题目自动命名；信息不足时保留原名。",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Name-paper-cloud", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "options_page": "options.html",
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
